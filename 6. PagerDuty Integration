# ============ 6. PagerDuty Integration ============
sudo tee /etc/alertmanager/alertmanager.yml >/dev/null <<'EOF'
route:
  receiver: pagerduty
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 1h

receivers:
  - name: pagerduty
    pagerduty_configs:
      - routing_key: "2235e33cc54e4209c017e871acea79b9" #add key pagerduty 
        severity: "critical"
EOF

sudo systemctl restart alertmanager
